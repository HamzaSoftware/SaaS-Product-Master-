{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PlatformDatabase": "Host=localhost;Port=5432;Database=saas_platform;Username=saas;Password=local_development_only"
  },
  "Authentication": {
    "Issuer": "saas-platform-api",
    "Audience": "saas-platform-web",
    "SigningKey": "replace-with-a-random-secret-at-least-32-characters"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"]
  },
  "PreventiveMaintenanceScheduler": {
    "Enabled": true,
    "IntervalMinutes": 60,
    "GenerateAheadDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
