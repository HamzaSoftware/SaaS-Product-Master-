root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj}]
indent_style = space
indent_size = 4

[*.{js,jsx,ts,tsx,json,css,md,yml,yaml}]
indent_style = space
indent_size = 2

[**/Migrations/*.cs]
# EF migrations are generated and use inline column arrays required by the fluent API.
dotnet_diagnostic.CA1861.severity = none
